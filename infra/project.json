{
  "name": "infra",
  "sourceRoot": "infra",
  "projectType": "library",
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker compose -f docker-compose.dev.yaml up -d"
          }
        ],
        "cwd": "infra"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "docker compose -f docker-compose.dev.yaml down"
          }
        ],
        "cwd": "infra"
      }
    }
  }
}
