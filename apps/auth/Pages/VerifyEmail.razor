@page "/verify-email"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IJSRuntime Js

<PageTitle>Verify email</PageTitle>

<h1>Verify your email</h1>

@if (_isVerifying)
{
    <p>Verifying your email address...</p>
}
else if (_isSuccessful)
{
    <p role="status">Your email address has been verified successfully.</p>
}
else
{
    <p role="alert">@_message</p>
}

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private bool _isVerifying = true;
    private bool _isSuccessful;
    private string _message = "The verification link is invalid.";

    protected override Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            _isVerifying = false;
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_isVerifying)
        {
            return;
        }

        var userId = UserId;
        var token = Token;
        if (string.IsNullOrWhiteSpace(userId) || string.IsNullOrWhiteSpace(token))
        {
            return;
        }

        try
        {
            var response = await Js.InvokeAsync<ApiResponse>(
                "authDevApi.call",
                "POST",
                $"/api/auth/verify-email?userId={Uri.EscapeDataString(userId)}&token={Uri.EscapeDataString(token)}",
                null);
            _isSuccessful = response.StatusCode is >= 200 and < 300;
            if (!_isSuccessful)
            {
                _message = "The email verification link is invalid or expired.";
            }
        }
        catch (JSException)
        {
            _message = "The verification service could not be reached. Please try again later.";
        }
        finally
        {
            _isVerifying = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private sealed class ApiResponse
    {
        public int StatusCode { get; set; }
    }
}
