{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://auth.smurftracker.local",
    "Audience": "smurftracker.local"
  },
  "OpenIddict": {
    "Scopes": [
      {
        "Name": "smurftracker-read",
        "DisplayName": "Read SmurfTracker data",
        "Resources": [
          "smurftracker-api"
        ]
      },
      {
        "Name": "smurftracker-write",
        "DisplayName": "Write SmurfTracker data",
        "Resources": [
          "smurftracker-api"
        ]
      }
    ]
  }
}
